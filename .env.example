# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="your_dataset"
SANITY_API_TOKEN=skSANITY_API_TOKEN_PLACEHOLDER
SANITY_SERVER_API_TOKEN=skSANITY_SERVER_TOKEN_PLACEHOLDER
SANITY_VIEWER_TOKEN=skSANITY_VIEWER_TOKEN_PLACEHOLDER
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3000/studio
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000/studio

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY

# OpenAI (primary chat LLM - ChatKit)
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY
OPENAI_CHAT_MODEL=gpt-5-mini
NEXT_PUBLIC_CHATKIT_WORKFLOW_ID=wf_YOUR_CHATKIT_WORKFLOW_ID

# OpenRouter (fallback multi-LLM for chat when OpenAI/ChatKit unavailable)
OPENROUTER_API_KEY=sk-or-YOUR_OPENROUTER_API_KEY
OPENROUTER_CHAT_MODEL=openrouter/auto

# Total AI Twin provider failover budget in milliseconds (10000-55000)
TWIN_CHAT_TIMEOUT_MS=28000

# Payments
# GiselPay (Mobile Money & Cards) - https://giselpay.com
GISELPAY_API_KEY=
NEXT_PUBLIC_GISELPAY_API_KEY=
GISELPAY_API_ENDPOINT=https://api.giselpay.com/api/v1/payments
GISELPAY_CHECKOUT_URL=https://pay.giselpay.com

# K-PAY (Orange & MTN Mobile Money, African markets) - https://k-pay.app
KPAY_API_KEY=
NEXT_PUBLIC_KPAY_API_KEY=
KPAY_API_ENDPOINT=https://api.k-pay.app/v1/payments

# CryptoMus (crypto payments) - https://cryptomus.com
CRYPTOMUS_API_KEY=
NEXT_PUBLIC_CRYPTOMUS_API_KEY=
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_ENDPOINT=https://api.cryptomus.com/v1/payment

# Coinbase Commerce (crypto payments) - https://commerce.coinbase.com
COINBASE_COMMERCE_API_KEY=
NEXT_PUBLIC_COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_API_ENDPOINT=https://api.commerce.coinbase.com/charges
