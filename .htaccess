# Apache front-controller / reverse proxy for Hostinger VPS
# Run the Next.js server on port 3000 with: npm run start
RewriteEngine On

# Proxy all application routes to the Node.js process
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteRule ^(.*)$ ws://127.0.0.1:3000/$1 [P,L]
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]

ProxyPreserveHost On
ProxyPassReverse / http://127.0.0.1:3000/

# Security defaults
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

